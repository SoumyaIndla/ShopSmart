# Local Spring Boot run (auto-imported from .env in the project root).
DB_PASSWORD=replace-with-your-local-mysql-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-local-admin-password

# Docker Compose: password for the MySQL container, also passed to the app as DB_PASSWORD.
MYSQL_ROOT_PASSWORD=replace-with-a-local-database-password
